##############################
## POSTGRESQL BACKUP CONFIG ##
##############################

# **Project**: aspaDB-workbench | **Path**: workbench/scripts/pg_backup.config
# **Version**: v1.3.1 | **Last Updated**: 2026-08-16 | **Author**: Manfred Koroschetz/AI
# **License**: SPDX-License-Identifier: MIT
#
# ## Changelog
# - v1.3.1 (2026-08-16): PGDATA_TARGET note - only pg_hba.conf is activated on
#   restore; postgresql.conf/auto.conf are reference-only (never written to PGDATA).
# - v1.3.0 (2026-08-16): PG_CONFIG_DIR is now AUTO-DETECTED when blank
#   (pg_backup.sh v1.4.0: SHOW config_file + docker mount mapping - version-
#   independent). PGDATA_TARGET defaults to $PGDATA for in-container restores.
# - v1.2.0 (2026-08-16): Added PG_CONFIG_DIR (config backup) + PGDATA_TARGET (config staging on restore)
# - v1.1.0 (2026-08-11): PGPWDFILE default to $PWD/.pgpass
# - v1.0.0 (2026-08-11): Initial standard header

# Optional system user to run backups as.  If the user the script is running as doesn't match this
# the script terminates.  Leave blank to skip check.
BACKUP_USER=

# Optional hostname to adhere to pg_hba policies.  Will default to "localhost" if none specified.
# Leave blank to use the local UNIX socket (recommended when running on the DB host).
HOSTNAME=

# Optional username to connect to database as.  Will default to "postgres" if none specified.
USERNAME=

# Optional path/name to pgpass file to avoid interactive password entry.
# Will default to "pgpass" in the local folder if none specified.
# This file must have permission "0600" to comply with PG specification to work correctly.
#PGPWDFILE=/mnt/data/aspadata/DB-Backup/.pgpass
PGPWDFILE=$PWD/.pgpass

# This dir will be created if it doesn't exist.  This must be writable by the user the script is
# running as.
#BACKUP_DIR=/mnt/data/postgres/backups/

## Maps to local folder which will be synced to remote server.
BACKUP_DIR=./

# This dir will be created if it doesn't exist.  This must be writable by the user the script is
# running as. Will not be created if empty.
LOG_DIR=

# List of strings to match against in database name, separated by space or comma, for which we only
# wish to keep a backup of the schema, not the data. Any database names which contain any of these
# values will be considered candidates. (e.g. "system_log" will match "dev_system_log_2010-01")
SCHEMA_ONLY_LIST=""

# Will produce a custom-format backup if set to "yes"
ENABLE_CUSTOM_BACKUPS=yes

# Will produce a gzipped plain-format backup if set to "yes"
# (custom format is sufficient for restore; plain is useful for grepping/inspection)
ENABLE_PLAIN_BACKUPS=yes

# Will produce gzipped sql file containing the cluster globals, like users and passwords, if set to "yes"
ENABLE_GLOBALS_BACKUPS=yes

# Host directory holding the LIVE postgresql.conf (e.g. the bind-mounted PGDATA
# or the anonymous docker volume path). pg_backup.sh copies postgresql.conf /
# postgresql.auto.conf / pg_hba.conf from here into <backup>/config/ so server
# tuning is part of the backup. Leave blank to AUTO-DETECT (pg_backup.sh v1.4.0:
# SHOW config_file via the backup connection + docker mount mapping - works for
# any PG version / container layout).
PG_CONFIG_DIR=

# Host path to the TARGET cluster's PGDATA (e.g. /mnt/db/IOTstack/volumes/postgres17/data).
# pg_restore.sh ACTIVATES the backup's pg_hba.conf here (copy + reload) - app-
# consistency critical. postgresql.conf / postgresql.auto.conf are REFERENCE-ONLY
# (stay in the backup's config/ for post-upgrade tuning; never written into PGDATA).
# Leave blank to skip activation; in-container restores default to $PGDATA.
PGDATA_TARGET=


#### SETTINGS FOR ROTATED BACKUPS ####

# Which day to take the weekly backup from (1-7 = Monday-Sunday)
DAY_OF_WEEK_TO_KEEP=7

# Number of days to keep daily backups
DAYS_TO_KEEP=7

# How many weeks to keep weekly backups
WEEKS_TO_KEEP=8


#### SETTINGS FOR DOCKER COMPOSE ####

DOCKER_COMPOSE_DIR=/root/IOTstack/
DOCKER_COMPOSE_FILE=docker-compose.yml

######################################