# SQL Workbench connection settings
# Copy this file to .env and fill in your actual values
# .env is gitignored - never commit real credentials

# Remote PostgreSQL server
PGHOST=your-server-ip-or-hostname
PGPORT=5432
PGDATABASE=your_database_name
PGUSER=reporter
PGPASSWORD=your_password

# Optional: use an SSH tunnel instead of direct connection
# If set to 1, connect to localhost:5432 (assumes: ssh -L 5432:localhost:5432 user@server)
PG_USE_SSH_TUNNEL=0

# Optional: connection timeout in seconds (default 10)
PGCONNECT_TIMEOUT=10